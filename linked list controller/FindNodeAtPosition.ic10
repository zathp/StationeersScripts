alias Ctrl d0
alias Pos d1
alias MinPosOut d2
alias MaxPosOut d3

define LIST_HEAD_SLOT 1
define LIST_TAIL_SLOT 2
define LIST_COUNT_SLOT 4
define NODE_BASE 32
define NODE_SIZE 4

Main:
l r1 Ctrl db LIST_COUNT_SLOT
blez r1 BoundsEmpty
move r2 -1
move r3 r1
s MinPosOut Setting r2
s MaxPosOut Setting r3
j BoundsDone
BoundsEmpty:
move r2 -1
s MinPosOut Setting r2
s MaxPosOut Setting r2
BoundsDone:
l r0 Pos Setting
jal FindNodeAtPosition
s db Setting r0
yield
j Main

NodeAddr:
mul r1 r0 NODE_SIZE
add r0 r1 NODE_BASE
j ra

FindNodeAtPosition:
push ra
push r1
push r2
push r3
push r4
push r5
push r6
get r1 Ctrl db LIST_COUNT_SLOT
beqz r1 FindFail
bltz r0 FindHead
bge r0 r1 FindTail
div r2 r1 2
blt r0 r2 FindFromHead
get r3 Ctrl db LIST_TAIL_SLOT
move r4 r1
sub r4 r4 1
move r5 r3
FindFromTailLoop:
beq r4 r0 FindFound
move r6 r5
jal NodeAddr
add r6 r0 1
get r5 Ctrl db r6
sub r4 r4 1
j FindFromTailLoop
FindFromHead:
get r5 Ctrl db LIST_HEAD_SLOT
move r4 0
FindFromHeadLoop:
beq r4 r0 FindFound
move r6 r5
jal NodeAddr
add r6 r0 2
get r5 Ctrl db r6
add r4 r4 1
j FindFromHeadLoop
FindFound:
move r0 r5
j FindExit
FindHead:
get r0 Ctrl db LIST_HEAD_SLOT
j FindExit
FindTail:
get r0 Ctrl db LIST_TAIL_SLOT
j FindExit
FindFail:
move r0 -1
FindExit:
pop r6
pop r5
pop r4
pop r3
pop r2
pop r1
pop ra
j ra
