define OP_GotoStationHash 1
define OP_HonkHorn 8
define OP_DeleteTimetable 16
define OP_StackPointer 63
define PhaseSourceRoute 1
define PhaseSourceCargo 2
define PhaseDestRoute 3
define PhaseDestCargo 4
define PhaseHomeRoute 5
define MaxCounter 10
alias Train d0
define CmdMem 511
define SourceHashMem 510
define DestHashMem 509
define HomeHash HASH("Dock Name")
alias phase r4
alias stationHash r5
alias prevQuantity r6
alias counter r7
alias cmd r8
start:
move phase 0
loop:
bnez phase running
get r0 db CmdMem
beqz r0 loopYield
get stationHash db SourceHashMem
s Train Setting stationHash
put Train 0 OP_HonkHorn
put Train 1 OP_GotoStationHash
put Train 2 OP_DeleteTimetable
put Train 63 63
add phase phase 1
running:
jal UpdateTrain
loopYield:
yield
j loop
UpdateTrain:
beqz phase endUpdateTrain
and r0 phase $000001
bnez r0 CheckStationArrival
and r0 phase $000002
bnez r0 LoadCargo
l r0 Train Quantity
beqz r0 doneUnloading
j endUpdateTrain
doneUnloading:
s Train Open 0
s Train Setting HomeHash
put Train 0 OP_HonkHorn
put Train 1 OP_GotoStationHash
put Train 2 OP_DeleteTimetable
put Train 63 63
add phase phase 1
j endUpdateTrain
LoadCargo:
l r0 Train Quantity
seq r1 r0 prevQuantity
move prevQuantity r0
mul counter r1 counter
bge counter MaxCounter doneLoading
add counter counter r1
j endUpdateTrain
doneLoading:
s Train Open 0
move prevQuantity 0
get stationHash db DestHashMem
s Train Setting stationHash
put Train 0 OP_HonkHorn
put Train 1 OP_GotoStationHash
put Train 2 OP_DeleteTimetable
put Train 63 63
add phase phase 1
j endUpdateTrain
CheckStationArrival:
l r0 Train Idle
l r1 Train PositionX
seq r1 r1 stationHash
and r0 r0 r1
beqz r0 endUpdateTrain
add phase phase 1
blt phase 6 LoadUnload
move phase 0
put db CmdMem 0
j endUpdateTrain
LoadUnload:
s Train Open 1
endUpdateTrain:
j ra
