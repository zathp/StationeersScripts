# Room atmosphere controller: maintains O2/N2 partial pressures, vents excess
# CO2 and overpressure, and flushes the room through the waste vent when a
# toxic gas (volatiles/pollutant) is detected.
alias GasSensor d0
alias WasteVent d1
alias CO2Vent d2
alias N2Vent d3
alias O2Vent d4
# Toxic gas ratio (percent) that triggers an emergency flush.
define ToxicPct 1
# Room pressure (kPa) the flush must reach before it ends.
define FlushFloorPressure 5
# Overpressure relief thresholds (kPa) for the waste vent, with hysteresis.
define MaxPressureHigh 80
define MaxPressureLow 70
# O2 partial pressure target band (kPa).
define O2Target 25
define O2Band 3
# N2 partial pressure target band (kPa).
define N2Target 25
define N2Band 3
# CO2 partial pressure band (kPa) before venting excess CO2.
define CO2High 25
define CO2Low 20

move r10 0 # FlushActive latch
move r11 0 # O2Vent latch
move r12 0 # N2Vent latch
move r13 0 # CO2Vent latch
move r14 0 # WasteVent overpressure latch

MainLoop:
l r0 GasSensor Pressure
l r1 GasSensor RatioOxygen
l r2 GasSensor RatioNitrogen
l r3 GasSensor RatioCarbonDioxide
l r4 GasSensor RatioMethane
l r5 GasSensor RatioPollutant
mul r6 r1 r0
mul r7 r2 r0
mul r8 r3 r0
mul r9 r4 100
sgt r15 r9 ToxicPct
bnez r15 ToxicDetected
mul r9 r5 100
sgt r15 r9 ToxicPct
bnez r15 ToxicDetected
j CheckFlushState
ToxicDetected:
move r10 1
CheckFlushState:
beqz r10 Normal
s WasteVent Mode 1
s WasteVent On 1
s CO2Vent On 0
s N2Vent On 0
s O2Vent On 0
sgt r15 r0 FlushFloorPressure
bnez r15 EndLoop
move r10 0
j EndLoop
Normal:
sgt r15 r0 MaxPressureHigh
bnez r15 WasteOn
slt r15 r0 MaxPressureLow
bnez r15 WasteOff
j CheckO2
WasteOn:
move r14 1
j ApplyWaste
WasteOff:
move r14 0
ApplyWaste:
s WasteVent Mode 1
s WasteVent On r14
CheckO2:
sub r15 O2Target O2Band
slt r9 r6 r15
bnez r9 O2On
add r15 O2Target O2Band
sgt r9 r6 r15
bnez r9 O2Off
j CheckN2
O2On:
move r11 1
j ApplyO2
O2Off:
move r11 0
ApplyO2:
s O2Vent Mode 0
s O2Vent On r11
CheckN2:
sub r15 N2Target N2Band
slt r9 r7 r15
bnez r9 N2On
add r15 N2Target N2Band
sgt r9 r7 r15
bnez r9 N2Off
j CheckCO2
N2On:
move r12 1
j ApplyN2
N2Off:
move r12 0
ApplyN2:
s N2Vent Mode 0
s N2Vent On r12
CheckCO2:
sgt r9 r8 CO2High
bnez r9 CO2On
slt r9 r8 CO2Low
bnez r9 CO2Off
j EndLoop
CO2On:
move r13 1
j ApplyCO2
CO2Off:
move r13 0
ApplyCO2:
s CO2Vent Mode 1
s CO2Vent On r13
EndLoop:
yield
j MainLoop
